# Database (docker compose up -d db)
DATABASE_URL="postgresql://trainer:trainer@localhost:5442/trainer?schema=public"

# Sessions
SESSION_HOURS=10
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Set to true behind HTTPS if the proxy does not send X-Forwarded-Proto
COOKIE_SECURE=false

# AI models — any OpenAI-compatible server. Leave LLM_BASE_URL empty for mock mode (no network).
# Cloud example:  LLM_BASE_URL=https://<provider>/v1   LLM_MODEL=<model>   LLM_API_KEY=<key>
# Local example:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech recognition (/audio/transcriptions), e.g. a local faster-whisper server
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# Speech synthesis (/audio/speech), e.g. a local Piper server
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

AI_TIMEOUT_MS=45000
# Model calls per minute per server process; above it the app answers by rules (budget guard for a public stand)
AI_MAX_CALLS_PER_MIN=300

# ── Example: Google Cloud models via Vertex AI (service-account key outside the repository) ──
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-sa.json   # dev; or GOOGLE_CREDENTIALS_JSON='{...}'
# GOOGLE_KEY_FILE=/path/to/google-sa.json                  # Docker: mounted into the container read-only
# LLM_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<project>/locations/global/endpoints/openapi
# LLM_MODEL=google/gemini-3.5-flash-lite        # phone counterparts: quick replies
# LLM_MODEL_SMART=google/gemini-3.5-flash       # grading and reading free text
# LLM_AUTH=google
# LLM_REASONING=low
# LLM_REASONING_TOKENS=1024
# STT_PROVIDER=google                           # Speech-to-Text v2
# STT_MODEL=chirp_3
# STT_LOCATION=us
# TTS_PROVIDER=google-live                      # Gemini Live voice, streamed; fallback Google Text-to-Speech
# TTS_VOICE_MALE=Charon
# TTS_VOICE_FEMALE=Kore

# Public demo stand: protect demo accounts from blocking and password changes
DEMO_MODE=false

# Where backups are written (Docker: /backups volume)
# BACKUP_DIR=./backups

# Server processes on one port (Docker image). Default: CPU cores, at most 4.
# APP_WORKERS=4
