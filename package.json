{
  "name": "trainer-112-dds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed-demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "e2e": "tsx --env-file=.env scripts/e2e-lesson.ts",
    "loadtest": "tsx --env-file=.env scripts/loadtest.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "1.59.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@9.14.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
